{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none",
  },
  "display": {
    "separator": "  ",
    "key": { "width": 16 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{#cyan}{user-name}{#default}@{#blue}{host-name}{#default}" },
    "break",
    { "type": "os", "key": " System", "keyColor": "blue", "format": "{name}" },
    { "type": "kernel", "key": "󰻿 Kernel", "keyColor": "blue", "format": "{release}" },
    { "type": "packages", "key": "󰏗 Apps", "keyColor": "blue", "format": "{all}" },
    { "type": "wm", "key": "󰕮 Desktop", "keyColor": "magenta" },
    { "type": "shell", "key": "󰆍 Shell", "keyColor": "magenta" },
    { "type": "terminal", "key": "󰆟 Term", "keyColor": "magenta" },
    { "type": "disk", "key": "󰋊 Disk", "keyColor": "cyan", "format": "{size-used} / {size-total}" },
  ]
}

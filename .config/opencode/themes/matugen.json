      "dark": "surface_variant",
      "light": "surface_variant"
    },
    "diffHighlightAdded": {
      "dark": "secondary",
      "light": "secondary"
    },
    "diffHighlightRemoved": {
      "dark": "error",
      "light": "error"
    },
    "diffAddedBg": {
      "dark": "surface_variant",
      "light": "surface_variant"
